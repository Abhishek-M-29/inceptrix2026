# Dockerfile.minimal
# Single-stage, self-contained build for the Inceptrix MCP pentest server.
# Base: kalilinux/kali-rolling (stable rolling Kali; all tools come from Kali apt)
#
# Policy: anything Kali provides in apt → use apt.
#         Dalfox: use go install (recommended by upstream).
#         jwt_tool: use pipx (no --break-system-packages).
#
# Build:
#   docker build -f Dockerfile.minimal -t inceptrix-mcp:latest .
#
# Run:
#   docker run --rm -p 8090:8090 -p 8091:8091 -p 3000-3010:3000-3010 inceptrix-mcp:latest
# ──────────────────────────────────────────────────────────────────────────────


FROM kalilinux/kali-rolling:latest


ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1


# ── 1. Tools from Kali apt repos (stable, Kali‑managed) ───────────────────────
# nmap, nikto, whatweb, sqlmap, wfuzz, ffuf, nuclei, httpx-toolkit, etc.
# Kali handles all deps and updates; we trust the repo.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nmap \
        nikto \
        whatweb \
        sqlmap \
        wfuzz \
        ffuf \
        nuclei \
        httpx-toolkit \
        python3 python3-pip python3-venv \
        git curl unzip ca-certificates \
        wordlists \
    && rm -rf /var/lib/apt/lists/*


# ── 2. Node.js 20 LTS (NodeSource) ────────────────────────────────────────────
# Use official NodeSource LTS, not Kali’s bundled nodejs.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*


# ── 3. Dalfox — only tool not in Kali apt; install Go then dalfox via go install
#     Fetch the latest stable Go version dynamically to avoid hardcoded 404s
RUN set -eux; \
    GOVER=$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -1); \
    curl -fsSL "https://go.dev/dl/${GOVER}.linux-amd64.tar.gz" | \
    tar -C /usr/local -xzf - \
    && ln -sf /usr/local/go/bin/go /usr/local/bin/go

# Install latest stable Dalfox (recommended upstream method)
RUN go install github.com/hahwul/dalfox/v2@latest \
    && ln -sf "$(go env GOPATH)/bin/dalfox" /usr/local/bin/dalfox


# ── 4. jwt_tool — clone + install deps + create wrapper script ───────────────
RUN git clone --depth 1 https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool \
    && pip3 install --break-system-packages -r /opt/jwt_tool/requirements.txt \
    && printf '#!/bin/sh\nexec python3 /opt/jwt_tool/jwt_tool.py "$@"\n' \
       > /usr/local/bin/jwt_tool \
    && chmod +x /usr/local/bin/jwt_tool


# ── 5. Python venv for MCP server (no impact on Kali’s Python) ───────────────
ENV VENV=/opt/mcp_venv
RUN python3 -m venv "${VENV}"
ENV PATH="${VENV}/bin:${PATH}"


WORKDIR /opt/inceptrix_mcp
COPY docker_mcp/requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt


# ── 6. Copy MCP server source ─────────────────────────────────────────────────
COPY docker_mcp/ .


# ── 7. Smoke test (Kali‑managed tools + stable Dalfox + jwt_tool) ────────────
RUN python3 -c "import fastmcp, fastapi, uvicorn, pydantic; print('Python deps OK')" \
    && nmap --version | head -1 \
    && nikto -Version 2>&1 | head -1 \
    && whatweb --version \
    && sqlmap --version 2>&1 | head -1 \
    && wfuzz --version 2>&1 | head -1 \
    && ffuf -V \
    && nuclei -version \
    && httpx-toolkit -version \
    && dalfox version \
    && jwt_tool --help 2>&1 | head -1 \
    && node --version && npm --version \
    && echo "=== All checks passed (stable config) ==="


RUN chmod +x start_services.sh


ENV MCP_PORT=8090 \
    API_PORT=8091 \
    LOG_LEVEL=INFO \
    LOG_FORMAT=json


# 8090 MCP HTTP  |  8091 REST API  |  3000-3010 sandbox dev servers
EXPOSE 8090 8091 3000 3001 3002 3003 3004 3005 3006 3007 3008 3009 3010


HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8091/health')" || exit 1


ENTRYPOINT ["bash", "start_services.sh"]
