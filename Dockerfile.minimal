# Dockerfile.minimal
# Single-stage, self-contained build for the Inceptrix MCP pentest server.
# Base: kalilinux/kali-rolling  (no intermediate images required)
#
# Build:
#   docker build -f Dockerfile.minimal -t inceptrix-mcp:latest .
#
# Run:
#   docker run --rm -p 8090:8090 -p 8091:8091 -p 3000-3010:3000-3010 inceptrix-mcp:latest
# ──────────────────────────────────────────────────────────────────────────────

FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── 1. System packages ────────────────────────────────────────────────────────
# Everything in one layer: Python, Ruby (WhatWeb), Perl (nikto),
# Node.js source-list tooling, nmap, wordlists, and build deps.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        ruby ruby-dev build-essential \
        perl libnet-ssleay-perl libio-socket-ssl-perl \
        nmap \
        git curl wget unzip ca-certificates \
        wordlists \
    && rm -rf /var/lib/apt/lists/*

# ── 2. Node.js 20 LTS ─────────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── 3. Python pentest tools (pip) ─────────────────────────────────────────────
RUN pip3 install --break-system-packages sqlmap wfuzz

# ── 4. nikto ─────────────────────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/sullo/nikto.git /opt/nikto \
    && chmod +x /opt/nikto/program/nikto.pl \
    && ln -sf /opt/nikto/program/nikto.pl /usr/local/bin/nikto

# ── 5. WhatWeb ───────────────────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/urbanadventurer/WhatWeb.git /opt/whatweb \
    && chmod +x /opt/whatweb/whatweb \
    && ln -sf /opt/whatweb/whatweb /usr/local/bin/whatweb

# ── 6. Pre-built Go binaries (ffuf, nuclei, httpx, dalfox) ───────────────────
# Fetches latest release from GitHub — no Go toolchain needed.
RUN set -eux; \
    # ffuf
    VER=$(curl -fsSL https://api.github.com/repos/ffuf/ffuf/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/'); \
    curl -fsSL "https://github.com/ffuf/ffuf/releases/download/v${VER}/ffuf_${VER}_linux_amd64.tar.gz" -o /tmp/ffuf.tar.gz; \
    tar -xzf /tmp/ffuf.tar.gz -C /usr/local/bin/ ffuf; \
    rm /tmp/ffuf.tar.gz; \
    # nuclei
    VER=$(curl -fsSL https://api.github.com/repos/projectdiscovery/nuclei/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/'); \
    curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/v${VER}/nuclei_${VER}_linux_amd64.zip" -o /tmp/nuclei.zip; \
    unzip -q /tmp/nuclei.zip nuclei -d /usr/local/bin/; \
    rm /tmp/nuclei.zip; \
    # httpx — installed as httpx-toolkit so it doesn't shadow the Python httpx CLI
    VER=$(curl -fsSL https://api.github.com/repos/projectdiscovery/httpx/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/'); \
    curl -fsSL "https://github.com/projectdiscovery/httpx/releases/download/v${VER}/httpx_${VER}_linux_amd64.zip" -o /tmp/httpx.zip; \
    unzip -q /tmp/httpx.zip httpx -d /tmp/; \
    mv /tmp/httpx /usr/local/bin/httpx-toolkit; \
    rm /tmp/httpx.zip; \
    # dalfox
    VER=$(curl -fsSL https://api.github.com/repos/hahwul/dalfox/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/'); \
    curl -fsSL "https://github.com/hahwul/dalfox/releases/download/v${VER}/dalfox_${VER}_linux_amd64.tar.gz" -o /tmp/dalfox.tar.gz; \
    tar -xzf /tmp/dalfox.tar.gz -C /usr/local/bin/ dalfox; \
    rm /tmp/dalfox.tar.gz; \
    chmod +x /usr/local/bin/ffuf /usr/local/bin/nuclei /usr/local/bin/httpx-toolkit /usr/local/bin/dalfox

# ── 7. jwt_tool ──────────────────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool \
    && pip3 install --break-system-packages -r /opt/jwt_tool/requirements.txt \
    && chmod +x /opt/jwt_tool/jwt_tool.py \
    && ln -sf /opt/jwt_tool/jwt_tool.py /usr/local/bin/jwt_tool

# ── 8. Python venv for MCP server ────────────────────────────────────────────
ENV VENV=/opt/mcp_venv
RUN python3 -m venv "${VENV}"
ENV PATH="${VENV}/bin:${PATH}"

WORKDIR /opt/inceptrix_mcp
COPY docker_mcp/requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ── 9. Copy MCP server source ─────────────────────────────────────────────────
COPY docker_mcp/ .

# ── 10. Smoke test ────────────────────────────────────────────────────────────
RUN python3 -c "import fastmcp, fastapi, uvicorn, pydantic; print('Python deps OK')" \
    && nmap --version | head -1 \
    && nikto -Version 2>&1 | head -1 \
    && whatweb --version \
    && sqlmap --version 2>&1 | head -1 \
    && wfuzz --version 2>&1 | head -1 \
    && ffuf -V \
    && nuclei -version \
    && httpx-toolkit -version \
    && dalfox version \
    && jwt_tool --help 2>&1 | head -1 \
    && node --version && npm --version \
    && echo "=== All checks passed ==="

RUN chmod +x start_services.sh

ENV MCP_PORT=8090 \
    API_PORT=8091 \
    LOG_LEVEL=INFO \
    LOG_FORMAT=json

# 8090 MCP HTTP  |  8091 REST API  |  3000-3010 sandbox dev servers
EXPOSE 8090 8091 3000 3001 3002 3003 3004 3005 3006 3007 3008 3009 3010

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8091/health')" || exit 1

ENTRYPOINT ["bash", "start_services.sh"]
