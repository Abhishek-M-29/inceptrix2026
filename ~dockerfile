FROM node:20-alpine

# Install git and bash — this layer is cached forever after the first build
RUN apk add --no-cache git bash

# Copy entrypoint script into the image
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 5173

# REPO_URL is injected as an env var at container run-time via -e REPO_URL=...
ENTRYPOINT ["/entrypoint.sh"]